# Copy to `.env` for local docker-compose, or to `.env.production` / `.env.dev`
# for droplet deploy (then encrypt to `.env.production.sops` / `.env.dev.sops`).
#
# On the droplet, DB_USERNAME and DB_DATABASE must match the logical database name
# (create-app-users.sh enforces this). Use a different DB_PASSWORD for prod and dev.

DB_HOST=private-smirksoftware-mysql-do-user-48687368-0.a.db.ondigitalocean.com
DB_PORT=25060
DB_DATABASE=wildrivers
DB_USERNAME=wildrivers
DB_PASSWORD=replace-me

APP_URL=https://wildrivers.firecrew.us
MYSQL_ATTR_SSL_CA=/certs/ca-certificate.crt
